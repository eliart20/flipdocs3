{
  "name": "flipdocs3",
  "version": "0.1.0",
  "description": "A fast React PDF and image flipbook with direct Three.js page turns.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/flipdocs.js",
  "module": "./dist/flipdocs.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/flipdocs.js"
    },
    "./style.css": "./dist/flipdocs.css",
    "./pdf.worker.min.mjs": "./dist/pdf.worker.min.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs public && vite",
    "build": "npm run clean && vite build && tsc -p tsconfig.lib.json && node scripts/copy-pdf-worker.mjs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "audit": "node scripts/audit-package.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run audit"
  },
  "keywords": [
    "pdf",
    "pdf-viewer",
    "flipbook",
    "page-turn",
    "pdfjs",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "pdfjs-dist": "5.5.207",
    "three": "^0.179.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
